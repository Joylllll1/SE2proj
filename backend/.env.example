# Server
PORT=3001

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/treehole

# JWT
JWT_SECRET=your-jwt-secret-here-change-in-production
JWT_REFRESH_SECRET=your-jwt-refresh-secret-here-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
ACCESS_COOKIE_MAX_AGE_MS=900000
REFRESH_COOKIE_MAX_AGE_MS=604800000
COOKIE_SAME_SITE=lax

# SMTP (邮件验证码)
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
VERIFY_CODE_EXPIRES_MIN=5

# CORS / Proxy
FRONTEND_ORIGIN=http://127.0.0.1:5173
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://8.133.199.246
TRUST_PROXY=false

# SSE
SSE_MAX_CONNECTIONS_PER_USER=3
SSE_MAX_CONNECTIONS_PER_IP=20

# Tool Loop Limits
AI_TOOL_MAX_CALLS=3
AI_TOOL_TIMEOUT_MS=8000
AI_STREAM_IDLE_TIMEOUT_MS=30000
AI_WEB_SEARCH_MAX_RESULTS=8
AI_WEB_SEARCH_BAIDU_API_KEY=
AI_WEB_SEARCH_BAIDU_URL=https://qianfan.baidubce.com/v2/ai_search/web_search

# Admin
ADMIN_CONTACT_QQ=

# LLM AI (DeepSeek/OpenAI/etc)
LLM_API_KEY=your-llm-api-key-here
LLM_API_URL=https://api.deepseek.com/v1/chat/completions
LLM_MODEL=deepseek-chat
